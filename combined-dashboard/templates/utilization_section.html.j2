    <span class="section-title">Workforce Health</span>
    <span class="toggle-icon">▾</span>
  </div>
  <div class="section-body">

    <!-- Headcount / attrition summary cards -->
    <div class="summary-cards" style="margin-bottom:16px;">
      <div class="card blue">
        <div class="card-num">{{ workforce.headcount_current }}</div>
        <div class="card-label">Headcount</div>
      </div>
      <div class="card green">
        <div class="card-num">{{ workforce.hires_ytd }}</div>
        <div class="card-label">Hires YTD</div>
      </div>
