<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ report_title }}</title>
<style>
:root {
  --bg-primary:      #F3F6FA;
  --bg-surface:      #FFFFFF;
  --bg-surface-hover:#EEF2F8;
  --bg-header:       #EEF2FA;
  --bg-header-hover: #E4EAF6;
  --text-primary:    #111827;
  --text-secondary:  #4B5675;
  --border:          #D1D9E8;
  --accent-primary:  #2563EB;
  --accent-secondary:#EFF4FF;
  --accent:          #2563EB;
  --crit:            #B91C1C;
  --crit-bg:         #FEF2F2;
  --crit-bd:         #FCA5A5;
  --warn:            #92400E;
  --warn-bg:         #FFFBEB;
  --warn-bd:         #FCD34D;
  --good:            #065F46;
  --good-bg:         #ECFDF5;
  --good-bd:         #A7F3D0;
}

/* ── Reset & Base ─────────────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
       font-size: 13px; color: var(--text-primary); background: var(--bg-primary); line-height: 1.5; }
h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: 12px; }
h3 { font-size: 0.95rem; font-weight: 600; margin-bottom: 8px; }
a { color: inherit; }

/* ── Layout ───────────────────────────────────────────────────────────────── */
.page-wrap { max-width: 1600px; margin: 0 auto; padding: 0 16px 40px; }

/* ── Header bar ───────────────────────────────────────────────────────────── */
.header-bar {
  background: var(--bg-header); color: var(--text-primary);
  padding: 14px 20px;
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 8px;
  position: sticky; top: 0; z-index: 200;
}
.header-bar h1 { font-size: 1.15rem; font-weight: 700; letter-spacing: 0.3px; }
.header-meta { font-size: 11px; opacity: 0.75; text-align: right; }

/* ── Tab bar ──────────────────────────────────────────────────────────────── */
.tab-bar {
  background: var(--bg-surface);
  border-bottom: 2px solid var(--border);
  display: flex; align-items: stretch;
  position: sticky; top: 52px; z-index: 190;
  box-shadow: 0 2px 6px rgba(0,0,0,.06);
}
.tab-btn {
  background: none; border: none; outline: none;
  padding: 12px 20px;
  font-size: 13px; font-weight: 600; cursor: pointer; color: var(--text-secondary);
  border-bottom: 3px solid transparent; margin-bottom: -2px;
  transition: color .15s, border-color .15s;
  display: flex; flex-direction: column; align-items: center; gap: 2px;
}
.tab-btn:hover { color: var(--text-primary); background: var(--bg-surface-hover); }
.tab-btn.active { color: var(--accent-primary); border-bottom-color: var(--accent-primary); }
.tab-btn .tab-sublabel { font-size: 10px; font-weight: 400; color: var(--text-secondary); }
.tab-btn.active .tab-sublabel { color: var(--text-secondary); }
.tab-pill {
  display: inline-block; border-radius: 10px; font-size: 10px; font-weight: 700;
  padding: 1px 6px; margin-left: 5px; vertical-align: middle;
}
.tab-pill.crit { background: var(--crit-bg); color: var(--crit); border: 1px solid var(--crit-bd); }
.tab-pill.warn { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-bd); }
.tab-pill.ok   { background: var(--good-bg); color: var(--good); border: 1px solid var(--good-bd); }

/* ── Tab panels ───────────────────────────────────────────────────────────── */
.tab-panel { display: none; }
.tab-panel.active { display: block; }

/* ── Summary cards ────────────────────────────────────────────────────────── */
.summary-cards {
  display: flex; flex-wrap: wrap; gap: 10px;
  padding: 16px 0 8px;
}
.card {
  background: var(--bg-surface); border-radius: 8px;
  padding: 12px 18px;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
  min-width: 130px; text-align: center;
}
.card .card-num { font-size: 1.8rem; font-weight: 700; line-height: 1; }
.card .card-label { font-size: 11px; color: var(--text-secondary); margin-top: 4px; }
.card.red    { border-top: 3px solid #ef4444; }
.card.yellow { border-top: 3px solid #f59e0b; }
.card.blue   { border-top: 3px solid #3b82f6; }
.card.gray   { border-top: 3px solid var(--text-secondary); }
.card.green  { border-top: 3px solid #22c55e; }

/* ── AI commentary card ───────────────────────────────────────────────────── */
.ai-card {
  background: var(--bg-surface); border-radius: 10px;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
  padding: 14px 18px; margin-top: 16px;
}
.ai-card-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
.ai-card-headline { font-weight: 700; font-size: 0.95rem; }
.ai-card-narrative { font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; }
.ai-card-action { font-size: 12px; color: var(--text-primary); }
.ai-card-action b { font-weight: 700; }

/* ── AI discovery cards ───────────────────────────────────────────────────── */
.disc-card {
  background: #F5F0FF; border: 1px solid #DDD0FF;
  border-left: 4px solid #7C3AED;
  border-radius: 8px; padding: 12px 16px; margin-top: 10px;
}
.disc-label {
  font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase;
  color: #6D28D9; margin-bottom: 5px;
}
.disc-title { font-size: 13px; font-weight: 700; margin-bottom: 5px; }
.disc-observation { font-size: 12px; color: var(--text-secondary); margin-bottom: 5px; }
.disc-action { font-size: 12px; color: var(--text-primary); }
.disc-confidence {
  font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
  padding: 2px 7px; border-radius: 10px; white-space: nowrap;
}
.disc-confidence.high   { background: #EDE9FE; color: #5B21B6; }
.disc-confidence.medium { background: #EEF2FF; color: #4338CA; }
.disc-confidence.low    { background: #F1F5F9; color: #64748B; }

/* ── Settings gear button ─────────────────────────────────────────────────── */
.btn-settings {
  background: none; border: 1px solid var(--border); border-radius: 6px;
  padding: 5px 9px; cursor: pointer; font-size: 15px; line-height: 1;
  color: var(--text-secondary); transition: background .15s, color .15s;
}
.btn-settings:hover { background: var(--bg-surface-hover); color: var(--text-primary); }

/* ── Settings modal ───────────────────────────────────────────────────────── */
.settings-overlay {
  display: none; position: fixed; inset: 0; z-index: 1000;
  background: rgba(0,0,0,.35); align-items: center; justify-content: center;
}
.settings-overlay.open { display: flex; }
.settings-modal {
  background: var(--bg-surface); border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0,0,0,.18);
  width: min(680px, 95vw); max-height: 85vh;
  display: flex; flex-direction: column; overflow: hidden;
}
.settings-hdr {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px; border-bottom: 1px solid var(--border); flex-shrink: 0;
}
.settings-hdr h2 { font-size: 1rem; font-weight: 700; margin: 0; }
.settings-close {
  background: none; border: none; cursor: pointer; font-size: 18px;
  color: var(--text-secondary); line-height: 1; padding: 2px 6px;
}
.settings-close:hover { color: var(--text-primary); }
.settings-body { overflow-y: auto; padding: 20px; flex: 1; }
.settings-section { margin-bottom: 20px; }
.settings-section-title {
  font-size: 11px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
  color: var(--text-secondary); margin-bottom: 10px;
  padding-bottom: 6px; border-bottom: 1px solid var(--border);
}
.settings-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
.settings-row label { font-size: 13px; min-width: 180px; }
.settings-num {
  width: 68px; padding: 5px 8px; border: 1px solid var(--border);
  border-radius: 5px; font-size: 13px; background: var(--bg-surface);
  color: var(--text-primary); text-align: right;
}
.settings-num:focus { outline: none; border-color: var(--accent-primary); }
.settings-unit { font-size: 12px; color: var(--text-secondary); }
.settings-tbl { width: 100%; border-collapse: collapse; font-size: 13px; }
.settings-tbl th {
  font-size: 11px; font-weight: 600; color: var(--text-secondary); text-align: center;
  padding: 5px 8px; border-bottom: 1px solid var(--border);
}
.settings-tbl th.l { text-align: left; }
.settings-tbl td { padding: 5px 8px; border-bottom: 1px solid var(--border); text-align: center; }
.settings-tbl td.div-name { text-align: left; font-weight: 600; }
.settings-tbl tr:last-child td { border-bottom: none; }
.settings-hint { font-size: 11px; color: var(--text-secondary); margin-top: 6px; }
.settings-ftr {
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  padding: 14px 20px; border-top: 1px solid var(--border); flex-shrink: 0;
}
.settings-status { font-size: 12px; color: var(--text-secondary); flex: 1; }
.btn-cancel {
  background: none; border: 1px solid var(--border); border-radius: 6px;
  padding: 7px 16px; font-size: 13px; cursor: pointer; color: var(--text-primary);
}
.btn-cancel:hover { background: var(--bg-surface-hover); }
.btn-apply {
  background: var(--accent-primary); color: #fff; border: none; border-radius: 6px;
  padding: 7px 18px; font-size: 13px; font-weight: 600; cursor: pointer;
  transition: opacity .15s;
}
.btn-apply:hover { opacity: .88; }
.btn-apply:disabled { opacity: .45; cursor: not-allowed; }
.progress-bar-wrap {
  height: 4px; background: var(--border); border-radius: 2px;
  overflow: hidden; margin-top: 6px; display: none;
}
.progress-bar-fill { height: 100%; background: var(--accent-primary); transition: width .3s; width: 0%; }

/* ── View info banner ─────────────────────────────────────────────────────── */
.view-banner {
  background: var(--bg-surface); border: 1px solid var(--border); border-radius: 4px;
  padding: 10px 16px; margin-top: 14px;
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  font-size: 13px; color: var(--text-secondary);
  border-left: 4px solid var(--accent-primary);
}
.view-banner strong { color: var(--text-primary); }

/* ── Sections ─────────────────────────────────────────────────────────────── */
.section {
  background: var(--bg-surface); border-radius: 10px;
  margin-top: 16px;
  box-shadow: 0 1px 4px rgba(0,0,0,.08);
  overflow: hidden;
}
.section-header {
  padding: 12px 18px;
  display: flex; align-items: center; justify-content: space-between;
  cursor: pointer; user-select: none;
  border-bottom: 1px solid var(--border);
}
.section-header:hover { background: var(--bg-surface-hover); }
.section-title { font-weight: 700; font-size: 0.95rem; }
.toggle-icon { font-size: 1rem; transition: transform 0.2s; }
.section-body { padding: 16px 18px; }
.section-body.collapsed { display: none; }

/* ── Flag cards ───────────────────────────────────────────────────────────── */
.flags-grid { display: flex; flex-direction: column; gap: 10px; }
.lead-group { margin-bottom: 6px; }
.lead-group-hdr {
  display: flex; align-items: center; gap: 10px;
  padding: 7px 12px; margin-bottom: 6px;
  background: var(--bg-surface); border-radius: 6px;
  border-left: 3px solid var(--accent);
}
.lead-group-name { font-size: 12px; font-weight: 700; color: var(--text-primary); }
.lead-group-count { font-size: 11px; color: var(--text-secondary); }
.lead-group-count span { font-weight: 700; color: var(--accent); }
.flag-card {
  border-radius: 8px; padding: 14px 16px;
  border-left: 4px solid;
}
.flag-card.critical { background: var(--crit-bg); border-color: var(--crit); }
.flag-card.warning  { background: var(--warn-bg); border-color: var(--warn); }
.flag-card-top { display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 6px; }
.flag-name { font-weight: 700; font-size: 0.95rem; }
.flag-meta { font-size: 11px; color: var(--text-secondary); margin-top: 2px; }
.flag-explanation { margin-top: 8px; font-size: 12px; }
.flag-periods { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 6px; }
.period-chip {
  background: var(--bg-surface); border: 1px solid var(--border); border-radius: 4px;
  padding: 3px 8px; font-size: 12px; color: var(--text-secondary);
}
.flag-table { margin-top: 10px; border-collapse: collapse; width: 100%; font-size: 13px; }
.flag-table th { background: var(--bg-header); padding: 4px 8px; text-align: left; font-weight: 600; }
.flag-table td { padding: 3px 8px; border-top: 1px solid var(--border); }

/* ── Badges ───────────────────────────────────────────────────────────────── */
.badge {
  display: inline-block;
  border-radius: 3px; padding: 1px 6px; font-size: 10px; font-weight: 700;
  margin-left: 4px; vertical-align: middle; text-transform: uppercase;
}
.badge-pt       { background: #0E1E40; color: #6DAAEE; border: 1px solid #1A3D70; }
.badge-partial  { background: #1A1535; color: #9E8FE8; border: 1px solid #3A2A60; }
.badge-corp     { background: var(--bg-surface); color: var(--text-secondary); border: 1px solid var(--border); }
.badge-critical { background: var(--crit-bg); color: var(--crit); border: 1px solid var(--crit-bd); }
.badge-warning  { background: var(--warn-bg); color: var(--warn); border: 1px solid var(--warn-bd); }
.badge-ok       { background: var(--good-bg); color: var(--good); border: 1px solid var(--good-bd); }

/* ── Filter bar ───────────────────────────────────────────────────────────── */
.filter-bar {
  display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
  margin-bottom: 12px;
}
.filter-bar select, .filter-bar input {
  border: 1px solid var(--border); border-radius: 5px;
  padding: 5px 8px; font-size: 12px;
  background: var(--bg-surface); cursor: pointer;
}
.filter-bar label { font-size: 11px; color: var(--text-secondary); }
.filter-reset {
  border: 1px solid var(--border); border-radius: 5px;
  padding: 5px 10px; font-size: 12px; cursor: pointer;
  background: var(--bg-surface); color: var(--text-secondary);
}
.filter-reset:hover { background: var(--bg-surface-hover); color: var(--text-primary); }

/* ── Team groups (division-first employee view) ─────────────────────────── */
.team-group { margin-bottom: 18px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
.team-group-header {
  background: var(--bg-surface-hover); padding: 10px 14px;
  display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;
  border-bottom: 1px solid var(--border);
}
.team-group-title { font-weight: 700; font-size: 0.95rem; display: flex; align-items: center; gap: 8px; }
.team-group-count { font-size: 11px; color: var(--text-secondary); font-weight: 400; }
.team-group-stats { display: flex; align-items: center; gap: 12px; font-size: 11px; color: var(--text-secondary); }
.team-group-stats strong { color: var(--text-primary); }

/* ── Employee table ───────────────────────────────────────────────────────── */
.emp-table-wrap { overflow-x: auto; }
.emp-table {
  width: 100%; border-collapse: collapse; font-size: 14px;
  table-layout: auto;
}
.emp-table th {
  background: var(--bg-header); color: var(--text-primary);
  padding: 8px 10px; text-align: left; white-space: nowrap;
  cursor: pointer; user-select: none;
}
.emp-table th:hover { background: var(--bg-header-hover); }
.emp-table th .sort-icon { margin-left: 4px; opacity: 0.6; font-size: 10px; }
.emp-table td { padding: 6px 10px; border-bottom: 1px solid var(--border); }
.emp-table tr.critical { background: var(--crit-bg); border-left: 3px solid var(--crit); }
.emp-table tr.warning  { background: var(--warn-bg); border-left: 3px solid var(--warn); }
.emp-table tr.gray     { background: var(--bg-surface); color: var(--text-secondary); }
.emp-table tr.ok       { background: var(--bg-surface); }
.emp-table tr:hover    { filter: brightness(1.12); }

/* ── Sparkline ────────────────────────────────────────────────────────────── */
.sparkline-cell { min-width: 120px; }
svg.sparkline { display: block; }

/* ── Summary tables ───────────────────────────────────────────────────────── */
.summary-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.summary-table th {
  background: var(--bg-header); color: var(--text-primary);
  padding: 8px 12px; text-align: left;
}
.summary-table td { padding: 7px 12px; border-bottom: 1px solid var(--border); }
.summary-table tr:hover td { background: var(--bg-surface-hover); }

/* ── Data quality lists ───────────────────────────────────────────────────── */
.dq-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
.dq-box { background: var(--bg-surface-hover); border-radius: 6px; padding: 12px; border: 1px solid var(--border); }
.dq-box h3 { font-size: 12px; color: var(--text-secondary); margin-bottom: 8px; }
.dq-list { list-style: none; max-height: 180px; overflow-y: auto; }
.dq-list li { font-size: 12px; padding: 2px 0; border-bottom: 1px solid var(--border); color: var(--text-secondary); }
.dq-empty { font-size: 11px; color: var(--text-secondary); font-style: italic; }

/* ── Config panel ─────────────────────────────────────────────────────────── */
.config-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
.config-item { font-size: 12px; display: flex; justify-content: space-between;
               padding: 5px 0; border-bottom: 1px solid var(--border); }
.config-key { color: var(--text-secondary); }
.config-val { font-weight: 600; }

/* ── Employee detail modal ────────────────────────────────────────────────── */
.modal-overlay {
  position: fixed; inset: 0; background: rgba(0,0,0,.5);
  z-index: 1000; display: flex; align-items: center; justify-content: center;
  padding: 16px;
}
.modal-box {
  background: var(--bg-surface); border-radius: 12px;
  max-width: 1100px; width: 100%; max-height: 88vh;
  overflow-y: auto;
  box-shadow: 0 20px 60px rgba(0,0,0,.35);
  display: flex; flex-direction: column;
}
.modal-header {
  padding: 14px 20px;
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  border-bottom: 1px solid var(--border);
  position: sticky; top: 0; background: var(--bg-surface); z-index: 10; flex-shrink: 0;
}
.modal-title-block { display: flex; flex-direction: column; gap: 2px; }
.modal-title-name { font-size: 1.1rem; font-weight: 700; }
.modal-title-meta { font-size: 11px; color: var(--text-secondary); }
.modal-close {
  background: none; border: 1px solid var(--border); border-radius: 6px;
  font-size: 1rem; cursor: pointer; color: var(--text-secondary);
  padding: 4px 10px; flex-shrink: 0;
}
.modal-close:hover { background: var(--bg-surface-hover); color: var(--text-primary); }
.modal-body { padding: 16px 20px; overflow-x: auto; flex: 1; }
.detail-table {
  width: 100%; border-collapse: collapse; font-size: 11.5px;
  white-space: nowrap;
}
.detail-table th {
  background: var(--bg-header); color: var(--text-primary);
  padding: 7px 10px; text-align: right; font-weight: 600;
}
.detail-table th:first-child { text-align: left; }
.detail-table td {
  padding: 5px 10px; border-bottom: 1px solid var(--border); text-align: right;
}
.detail-table td:first-child { text-align: left; font-weight: 500; }
.detail-table tr.no-data td { color: var(--text-secondary); background: var(--bg-surface-hover); }
.detail-table tr.crit-row td { background: var(--crit-bg); }
.detail-table tr.warn-row td { background: var(--warn-bg); }
.detail-table tfoot td {
  padding: 7px 10px; font-weight: 600; background: var(--bg-surface-hover);
  border-top: 2px solid var(--border);
}
.detail-table tfoot td:first-child { text-align: left; }
.modal-footnote {
  font-size: 10px; color: var(--text-secondary); margin-top: 10px; padding-bottom: 4px;
}

/* Clickable table rows */
.emp-table tbody tr { cursor: pointer; }

/* ── Print ────────────────────────────────────────────────────────────────── */
@media print {
  .header-bar, .tab-bar { position: static; }
  .tab-panel { display: block !important; }
  .section-body.collapsed { display: block !important; }
  .filter-bar { display: none; }
  .emp-table th { position: static; }
}
</style>
</head>
<body>

<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- HEADER                                                                   -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
<div class="settings-overlay" id="settings-overlay" onclick="if(event.target===this)closeSettings()">
  <div class="settings-modal">
    <div class="settings-hdr">
      <h2>⚙ Threshold Settings</h2>
      <button class="settings-close" onclick="closeSettings()">✕</button>
    </div>
    <div class="settings-body">
      <!-- Persistence -->
      <div class="settings-section">
        <div class="settings-section-title">Trend Persistence</div>
        <div class="settings-row">
          <label>Consecutive periods to flag</label>
          <input type="number" class="settings-num" id="s-persist" min="1" max="12" step="1" value="3">
          <span class="settings-unit">periods</span>
        </div>
        <div class="settings-hint">An employee must fall below the threshold for this many periods in a row before a flag is raised.</div>
      </div>
      <!-- Global thresholds -->
      <div class="settings-section">
        <div class="settings-section-title">Global Billable Utilization Thresholds</div>
        <div class="settings-row">
          <label>Benchmark (good)</label>
          <input type="number" class="settings-num" id="s-bench" min="0" max="100" step="1" value="75">
          <span class="settings-unit">%</span>
        </div>
        <div class="settings-row">
          <label>Warning below</label>
          <input type="number" class="settings-num" id="s-warn" min="0" max="100" step="1" value="65">
          <span class="settings-unit">%</span>
        </div>
        <div class="settings-row">
          <label>Critical below</label>
          <input type="number" class="settings-num" id="s-crit" min="0" max="100" step="1" value="50">
          <span class="settings-unit">%</span>
        </div>
      </div>
      <!-- Per-division overrides -->
      <div class="settings-section">
        <div class="settings-section-title">Per-Division Overrides <span style="font-weight:400;text-transform:none;letter-spacing:0">(blank = use global)</span></div>
        <table class="settings-tbl" id="div-tbl">
          <thead><tr>
            <th class="l">Division</th>
            <th>Benchmark %</th>
            <th>Warning %</th>
            <th>Critical %</th>
          </tr></thead>
          <tbody id="div-tbody">
            <!-- populated by JS -->
          </tbody>
        </table>
        <div class="settings-hint">Leave a field blank to inherit the global value for that division.</div>
      </div>
    </div>
    <div class="settings-ftr">
      <div>
        <div class="settings-status" id="s-status">Loading current settings…</div>
        <div class="progress-bar-wrap" id="s-progress-wrap">
          <div class="progress-bar-fill" id="s-progress-fill"></div>
        </div>
      </div>
      <button class="btn-cancel" onclick="closeSettings()">Cancel</button>
      <button class="btn-apply" id="s-apply-btn" onclick="applySettings()">Save &amp; Re-run</button>
    </div>
  </div>
</div>

<div class="header-bar">
  <div>
    <h1>{{ report_title }}</h1>
    <div style="font-size:11px;opacity:.7;margin-top:2px;">
      Full Period: {{ period_range }}
      {% if pipeline_summary %}
        &nbsp;|&nbsp; Run: {{ pipeline_summary.get('Run Date', '') }}
      {% endif %}
    </div>
  </div>
  <div style="display:flex;align-items:center;gap:10px;">
    <div class="header-meta">Generated {{ generated_date }}</div>
    <button class="btn-settings" onclick="openSettings()" title="Threshold settings">⚙</button>
  </div>
</div>

<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- TAB BAR                                                                  -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
<div class="tab-bar" role="tablist">
  {% for view in views %}
  <button class="tab-btn{% if loop.first %} active{% endif %}"
          data-tab="{{ view.view_id }}"
          onclick="switchTab('{{ view.view_id }}')"
          role="tab">
    {{ view.view_label }}
    {% if view.critical_count > 0 %}
      <span class="tab-pill crit">{{ view.critical_count }}C</span>
    {% endif %}
    {% if view.warning_count > 0 %}
      <span class="tab-pill warn">{{ view.warning_count }}W</span>
    {% endif %}
    <span class="tab-sublabel">{{ view.view_sublabel }}</span>
  </button>
  {% endfor %}
</div>

<div class="page-wrap">

{% for view in views %}
<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- TAB PANEL: {{ view.view_label }}                                          -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
<div id="tab-{{ view.view_id }}" class="tab-panel{% if loop.first %} active{% endif %}" role="tabpanel">

  <!-- View info banner -->
  <div class="view-banner">
    <span><strong>{{ view.view_label }}</strong> &mdash; {{ view.view_sublabel }}</span>
    <span>Date range: <strong>{{ view.view_period_range }}</strong></span>
    <span>{{ view.view_period_count }} half-month period{{ 's' if view.view_period_count != 1 else '' }}</span>
    <span>Persistence threshold: <strong>{{ view.view_persistence }}</strong> consecutive period{{ 's' if view.view_persistence != 1 else '' }}</span>
  </div>

  <!-- Summary cards -->
  <div class="summary-cards">
    <div class="card blue">
      <div class="card-num">{{ employees_analyzed }}</div>
      <div class="card-label">Employees Analyzed</div>
    </div>
    <div class="card gray">
      <div class="card-num">{{ corp_roles_count }}</div>
      <div class="card-label">Corp Roles Excluded</div>
    </div>
    <div class="card gray">
      <div class="card-num">{{ pt_count }}</div>
      <div class="card-label">PT Employees</div>
    </div>
    <div class="card red">
      <div class="card-num">{{ view.critical_count }}</div>
      <div class="card-label">Critical Flags</div>
    </div>
    <div class="card yellow">
      <div class="card-num">{{ view.warning_count }}</div>
      <div class="card-label">Warning Flags</div>
    </div>
    <div class="card gray">
      <div class="card-num">{{ data_quality_issues }}</div>
      <div class="card-label">Data Quality Issues</div>
    </div>
  </div>

  {% if view.ai_commentary %}
  <div class="ai-card">
    <div class="ai-card-top">
      <div class="ai-card-headline">{{ view.ai_commentary.headline }}</div>
      {% if view.ai_commentary.risk_level == 'high' %}<span class="badge badge-critical">High Risk</span>
      {% elif view.ai_commentary.risk_level == 'medium' %}<span class="badge badge-warning">Medium Risk</span>
      {% else %}<span class="badge badge-ok">Low Risk</span>{% endif %}
    </div>
    <div class="ai-card-narrative">{{ view.ai_commentary.narrative }}</div>
    <div class="ai-card-action"><b>Recommended:</b> {{ view.ai_commentary.recommended_action }}</div>
  </div>
  {% endif %}

  {% if loop.first and util_discoveries %}
  {% for d in util_discoveries %}
  <div class="disc-card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:5px;">
      <div class="disc-label">AI Discovery</div>
      <span class="disc-confidence {{ d.confidence }}">{{ d.confidence }}</span>
    </div>
    <div class="disc-title">{{ d.title }}</div>
    <div class="disc-observation">{{ d.observation }}</div>
    <div class="disc-action"><b>Suggested:</b> {{ d.suggested_action }}</div>
  </div>
  {% endfor %}
  {% endif %}

  <!-- ── Critical Flags ────────────────────────────────────────────────── -->
  <div class="section">
    <div class="section-header" onclick="toggleSection(this)" data-open="true">
      <span class="section-title">Critical Flags ({{ view.critical_flags|length }})</span>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      {% if view.critical_flags %}
      <div class="flags-grid">
        {% for lead, lead_flags in view.critical_flags | groupby('portfolio_lead') %}
        <div class="lead-group">
          <div class="lead-group-hdr">
            <span class="lead-group-name">{{ lead or 'Unassigned' }}</span>
            <span class="lead-group-count"><span>{{ lead_flags | list | length }}</span> flagged</span>
          </div>
        {% for flag in lead_flags %}
        <div class="flag-card critical">
          <div class="flag-card-top">
            <div>
              <span class="flag-name">{{ flag.person }}</span>
              {% if flag.is_pt %}<span class="badge badge-pt">PT</span>{% endif %}
              {% if flag.is_partial %}<span class="badge badge-partial">Partial Period</span>{% endif %}
              <div class="flag-meta">{{ flag.division }} &nbsp;&middot;&nbsp; {{ flag.portfolio_lead }}</div>
            </div>
            <span class="badge badge-critical">Critical</span>
          </div>
          {% for issue in flag.issues %}
          <div style="margin-top:10px;{% if not loop.first %}padding-top:10px;border-top:1px solid var(--crit-bd);{% endif %}">
            <div style="font-weight:600;font-size:12px;">
              {{ issue.trend_label }}
              {% if issue.severity == 'warning' %}<span class="badge badge-warning" style="font-size:10px;margin-left:6px;">Warning</span>{% endif %}
            </div>
            <div class="flag-explanation">{{ issue.explanation }}</div>
            <div class="flag-periods">
              {% for lbl in issue.period_labels %}<span class="period-chip">{{ lbl }}</span>{% endfor %}
            </div>
            {% if issue.per_period_metrics %}
            <div style="overflow-x:auto;margin-top:6px;">
            <table class="flag-table">
              <thead>
                <tr>
                  <th>Period</th><th>Bill. Util*</th><th>Direct Util*</th>
                  <th>Bill. Hrs</th><th data-opt>PTO</th><th data-opt>Holiday</th><th data-opt>LWOP</th><th data-opt>Other</th>
                  <th>Time-Off Total</th><th>Sched. Hrs</th><th>Adj. Avail*</th>
                  <th data-opt>B&amp;P Hrs</th><th data-opt>B&amp;P %</th>
                  <th data-opt>G&amp;A Hrs</th><th data-opt>G&amp;A %</th>
                  <th data-opt>IR&amp;D Hrs</th><th data-opt>IR&amp;D %</th>
                  <th data-opt>Overhead Hrs</th><th data-opt>Overhead %</th>
                  <th data-opt>Non-Bill Hrs</th><th>Non-Bill %</th>
                </tr>
              </thead>
              <tbody>
                {% for m in issue.per_period_metrics %}
                <tr{% if m.no_data %} style="background:var(--bg-surface-hover);"{% endif %}>
                  <td>{{ m.period_label }}{% if m.no_data %} <span class="badge badge-corp">No Data</span>{% endif %}</td>
                  <td>{{ m.billable_util }}</td><td>{{ m.direct_util }}</td>
                  <td>{{ m.billable_hrs }}</td><td>{{ m.pto_hrs }}</td>
                  <td>{{ m.holiday_hrs }}</td><td>{{ m.lwop_hrs }}</td>
                  <td>{{ m.other_hrs }}</td><td>{{ m.time_off_hrs }}</td>
                  <td>{{ m.net_available }}</td><td>{{ m.effective_available }}</td>
                  <td>{{ m.bp_hrs }}</td><td>{{ m.bp_ratio }}</td>
                  <td>{{ m.ga_hrs }}</td><td>{{ m.ga_ratio }}</td>
                  <td>{{ m.ird_hrs }}</td><td>{{ m.ird_ratio }}</td>
                  <td>{{ m.overhead_hrs }}</td><td>{{ m.overhead_ratio }}</td>
                  <td>{{ m.nonbillable_hrs }}</td><td>{{ m.nonbillable_ratio }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
            <div style="font-size:10px;color:#9ca3af;margin-top:4px;">* Utilization calculated against Adj. Avail (Scheduled Hrs minus Time-Off). "No Data" rows had zero hours logged in every category despite scheduled hours — likely an unsubmitted timesheet, not true low utilization.</div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endfor %}
        </div><!-- /lead-group -->
        {% endfor %}
      </div>
      {% else %}
      <p style="color:#9ca3af;font-style:italic;">No critical flags for this period range.</p>
      {% endif %}
    </div>
  </div>

  <!-- ── Warning Flags ─────────────────────────────────────────────────── -->
  <div class="section">
    <div class="section-header" onclick="toggleSection(this)" data-open="true">
      <span class="section-title">Warning Flags ({{ view.warning_flags|length }})</span>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      {% if view.warning_flags %}
      <div class="flags-grid">
        {% for lead, lead_flags in view.warning_flags | groupby('portfolio_lead') %}
        <div class="lead-group">
          <div class="lead-group-hdr">
            <span class="lead-group-name">{{ lead or 'Unassigned' }}</span>
            <span class="lead-group-count"><span>{{ lead_flags | list | length }}</span> flagged</span>
          </div>
        {% for flag in lead_flags %}
        <div class="flag-card warning">
          <div class="flag-card-top">
            <div>
              <span class="flag-name">{{ flag.person }}</span>
              {% if flag.is_pt %}<span class="badge badge-pt">PT</span>{% endif %}
              {% if flag.is_partial %}<span class="badge badge-partial">Partial Period</span>{% endif %}
              <div class="flag-meta">{{ flag.division }} &nbsp;&middot;&nbsp; {{ flag.portfolio_lead }}</div>
            </div>
            <span class="badge badge-warning">Warning</span>
          </div>
          {% for issue in flag.issues %}
          <div style="margin-top:10px;{% if not loop.first %}padding-top:10px;border-top:1px solid var(--warn-bd);{% endif %}">
            <div style="font-weight:600;font-size:12px;">{{ issue.trend_label }}</div>
            <div class="flag-explanation">{{ issue.explanation }}</div>
            <div class="flag-periods">
              {% for lbl in issue.period_labels %}<span class="period-chip">{{ lbl }}</span>{% endfor %}
            </div>
            {% if issue.per_period_metrics %}
            <div style="overflow-x:auto;margin-top:6px;">
            <table class="flag-table">
              <thead>
                <tr>
                  <th>Period</th><th>Bill. Util*</th><th>Direct Util*</th>
                  <th>Bill. Hrs</th><th data-opt>PTO</th><th data-opt>Holiday</th><th data-opt>LWOP</th><th data-opt>Other</th>
                  <th>Time-Off Total</th><th>Sched. Hrs</th><th>Adj. Avail*</th>
                  <th data-opt>B&amp;P Hrs</th><th data-opt>B&amp;P %</th>
                  <th data-opt>G&amp;A Hrs</th><th data-opt>G&amp;A %</th>
                  <th data-opt>IR&amp;D Hrs</th><th data-opt>IR&amp;D %</th>
                  <th data-opt>Overhead Hrs</th><th data-opt>Overhead %</th>
                  <th data-opt>Non-Bill Hrs</th><th>Non-Bill %</th>
                </tr>
              </thead>
              <tbody>
                {% for m in issue.per_period_metrics %}
                <tr{% if m.no_data %} style="background:var(--bg-surface-hover);"{% endif %}>
                  <td>{{ m.period_label }}{% if m.no_data %} <span class="badge badge-corp">No Data</span>{% endif %}</td>
                  <td>{{ m.billable_util }}</td><td>{{ m.direct_util }}</td>
                  <td>{{ m.billable_hrs }}</td><td>{{ m.pto_hrs }}</td>
                  <td>{{ m.holiday_hrs }}</td><td>{{ m.lwop_hrs }}</td>
                  <td>{{ m.other_hrs }}</td><td>{{ m.time_off_hrs }}</td>
                  <td>{{ m.net_available }}</td><td>{{ m.effective_available }}</td>
                  <td>{{ m.bp_hrs }}</td><td>{{ m.bp_ratio }}</td>
                  <td>{{ m.ga_hrs }}</td><td>{{ m.ga_ratio }}</td>
                  <td>{{ m.ird_hrs }}</td><td>{{ m.ird_ratio }}</td>
                  <td>{{ m.overhead_hrs }}</td><td>{{ m.overhead_ratio }}</td>
                  <td>{{ m.nonbillable_hrs }}</td><td>{{ m.nonbillable_ratio }}</td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
            </div>
            <div style="font-size:10px;color:#9ca3af;margin-top:4px;">* Utilization calculated against Adj. Avail (Scheduled Hrs minus Time-Off). "No Data" rows had zero hours logged in every category despite scheduled hours — likely an unsubmitted timesheet, not true low utilization.</div>
            {% endif %}
          </div>
          {% endfor %}
        </div>
        {% endfor %}
        </div><!-- /lead-group -->
        {% endfor %}
      </div>
      {% else %}
      <p style="color:#9ca3af;font-style:italic;">No warning flags for this period range.</p>
      {% endif %}
    </div>
  </div>

  <!-- ── Utilization by Team ──────────────────────────────────────────── -->
  <div class="section">
    <div class="section-header" onclick="toggleSection(this)" data-open="true">
      <span class="section-title">Utilization by Team ({{ view.team_groups|length }} division{{ 's' if view.team_groups|length != 1 else '' }}, {{ view.table_rows|length }} employees)</span>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">

      <div class="filter-bar">
        <label>Division:
          <select id="f-division-{{ view.view_id }}" onchange="applyFilters('{{ view.view_id }}')">
            <option value="">All</option>
            {% for g in view.team_groups %}<option value="{{ g.division }}">{{ g.division }}</option>{% endfor %}
          </select>
        </label>
        <label>Portfolio Lead:
          <select id="f-lead-{{ view.view_id }}" onchange="applyFilters('{{ view.view_id }}')">
            <option value="">All</option>
            {% set leads = view.table_rows|map(attribute='portfolio_lead')|unique|sort %}
            {% for l in leads %}<option value="{{ l }}">{{ l }}</option>{% endfor %}
          </select>
        </label>
        <label>Flag:
          <select id="f-flag-{{ view.view_id }}" onchange="applyFilters('{{ view.view_id }}')">
            <option value="">All</option>
            <option value="Critical">Critical</option>
            <option value="Warning">Warning</option>
            <option value="OK">OK</option>
          </select>
        </label>
        <label>Type:
          <select id="f-emptype-{{ view.view_id }}" onchange="applyFilters('{{ view.view_id }}')">
            <option value="">All</option>
            <option value="PT">PT Only</option>
            <option value="FT">FT Only</option>
            <option value="Corp">Corp Role</option>
            <option value="Partial">Partial Period</option>
          </select>
        </label>
        <label>Search:
          <input type="text" id="f-search-{{ view.view_id }}" placeholder="Name..."
                 oninput="applyFilters('{{ view.view_id }}')" style="width:140px;">
        </label>
        <button class="filter-reset" onclick="resetFilters('{{ view.view_id }}')">Reset</button>
        <span id="f-count-{{ view.view_id }}" style="font-size:11px;color:#6b7280;"></span>
      </div>

      {% for g in view.team_groups %}
      <div class="team-group" data-view="{{ view.view_id }}" id="team-group-{{ view.view_id }}-{{ loop.index }}">
        <div class="team-group-header">
          <div class="team-group-title">
            {{ g.division }}
            <span class="team-group-count">{{ g.member_count }} employee{{ 's' if g.member_count != 1 else '' }}</span>
          </div>
          <div class="team-group-stats">
            <span>Avg Bill. Util: <strong>{{ g.avg_billable_util }}</strong></span>
            <span>Avg Direct Util: <strong>{{ g.avg_direct_util }}</strong></span>
            {% if g.critical_count > 0 %}<span class="badge badge-critical">{{ g.critical_count }} Critical</span>{% endif %}
            {% if g.warning_count > 0 %}<span class="badge badge-warning">{{ g.warning_count }} Warning</span>{% endif %}
            {% if g.critical_count == 0 and g.warning_count == 0 %}<span class="badge badge-ok">All OK</span>{% endif %}
          </div>
        </div>
        <div class="emp-table-wrap">
          <table class="emp-table" id="emp-table-{{ view.view_id }}-{{ loop.index }}">
            <thead>
              <tr>
                <th onclick="sortTable(0,'str','{{ view.view_id }}-{{ loop.index }}')">Name <span class="sort-icon">⇅</span></th>
                <th>Badges</th>
                <th onclick="sortTable(2,'str','{{ view.view_id }}-{{ loop.index }}')">Org <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(3,'str','{{ view.view_id }}-{{ loop.index }}')">Lead <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(4,'str','{{ view.view_id }}-{{ loop.index }}')">Type <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(5,'num','{{ view.view_id }}-{{ loop.index }}')">Bill. Util <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(6,'num','{{ view.view_id }}-{{ loop.index }}')">Direct Util <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(7,'num','{{ view.view_id }}-{{ loop.index }}')">Non-Bill % <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(8,'num','{{ view.view_id }}-{{ loop.index }}')">G&amp;A % <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(9,'num','{{ view.view_id }}-{{ loop.index }}')">B&amp;P Hrs <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(10,'num','{{ view.view_id }}-{{ loop.index }}')">PTO Hrs <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(11,'num','{{ view.view_id }}-{{ loop.index }}')">LWOP Hrs <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(12,'str','{{ view.view_id }}-{{ loop.index }}')">Flag <span class="sort-icon">⇅</span></th>
                <th onclick="sortTable(13,'num','{{ view.view_id }}-{{ loop.index }}')">Periods Active <span class="sort-icon">⇅</span></th>
                <th class="sparkline-cell">Billable Util Trend (Full Year)</th>
              </tr>
            </thead>
            <tbody id="emp-tbody-{{ view.view_id }}-{{ loop.index }}">
              {% for row in g.rows %}
              <tr class="{{ row.row_color }}"
                  onclick="openEmployeeModal(this)"
                  data-division="{{ row.division }}"
                  data-lead="{{ row.portfolio_lead }}"
                  data-flag="{{ row.flag_status }}"
                  data-org="{{ row.person_org }}"
                  data-type="{{ row.project_type }}"
                  data-pt="{{ 'PT' if row.is_pt else '' }}"
                  data-corp="{{ 'Corp' if row.is_corp else '' }}"
                  data-partial="{{ 'Partial' if row.is_partial else '' }}"
                  data-name="{{ row.person }}"
                  data-col6="{{ row.avg_billable_util_raw }}"
                  data-col7="{{ row.avg_direct_util_raw }}"
                  data-col8="{{ row.avg_nonbillable_pct }}"
                  data-col9="{{ row.avg_ga_pct }}"
                  data-col10="{{ row.total_bp_hrs }}"
                  data-col11="{{ row.total_pto_hrs }}"
                  data-col12="{{ row.total_lwop_hrs }}"
                  data-col14="{{ row.periods_active }}"
                  data-detail='{{ row.detail_periods }}'>
                <td>{{ row.person }}</td>
                <td>
                  {% if row.is_pt %}<span class="badge badge-pt">PT</span>{% endif %}
                  {% if row.is_partial %}<span class="badge badge-partial">Partial</span>{% endif %}
                  {% if row.is_corp %}<span class="badge badge-corp">Corp Role</span>{% endif %}
                </td>
                <td>{{ row.person_org }}</td>
                <td>{{ row.portfolio_lead }}</td>
                <td>{{ row.project_type }}</td>
                <td>{{ row.avg_billable_util }}</td>
                <td>{{ row.avg_direct_util }}</td>
                <td>{{ row.avg_nonbillable_pct }}</td>
                <td>{{ row.avg_ga_pct }}</td>
                <td>{{ row.total_bp_hrs }}</td>
                <td>{{ row.total_pto_hrs }}</td>
                <td>{{ row.total_lwop_hrs }}</td>
                <td>
                  {% if row.flag_status == 'Critical' %}<span class="badge badge-critical">Critical</span>
                  {% elif row.flag_status == 'Warning' %}<span class="badge badge-warning">Warning</span>
                  {% else %}<span class="badge badge-ok">OK</span>{% endif %}
                </td>
                <td>{{ row.periods_active }}</td>
                <td class="sparkline-cell">
                  <svg class="sparkline" width="120" height="36"
                       data-spark='{{ row.sparkline }}'
                       data-warn="{{ billable_warning_threshold }}"
                       data-crit="{{ billable_critical_threshold }}">
                  </svg>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>

  <!-- ── Portfolio Lead Summary ─────────────────────────────────────────── -->
  <div class="section">
    <div class="section-header" onclick="toggleSection(this)" data-open="true">
      <span class="section-title">Portfolio Lead Summary</span>
      <span class="toggle-icon">▾</span>
    </div>
    <div class="section-body">
      <table class="summary-table">
        <thead>
          <tr>
            <th>Portfolio Lead</th>
            <th># Employees</th>
            <th>Avg Billable Util</th>
            <th>Avg Direct Util</th>
            <th>Billable Util Trend</th>
            <th>Critical Flags</th>
            <th>Warning Flags</th>
          </tr>
        </thead>
        <tbody>
          {% for row in view.portfolio_rows %}
          <tr>
            <td><strong>{{ row.lead }}</strong></td>
            <td>{{ row.member_count }}</td>
            <td>{{ row.avg_billable_util }}</td>
            <td>{{ row.avg_direct_util }}</td>
            <td>
              <svg class="sparkline" width="120" height="28"
                   data-spark='{{ row.sparkline }}'
                   data-warn="{{ billable_warning_threshold }}"
                   data-crit="{{ billable_critical_threshold }}">
              </svg>
            </td>
            <td>{% if row.critical_count > 0 %}<span class="badge badge-critical">{{ row.critical_count }}</span>{% else %}&mdash;{% endif %}</td>
            <td>{% if row.warning_count > 0 %}<span class="badge badge-warning">{{ row.warning_count }}</span>{% else %}&mdash;{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>


</div><!-- /tab-panel -->
{% endfor %}

