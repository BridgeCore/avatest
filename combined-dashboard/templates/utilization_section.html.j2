<!-- ════════════════════════════════════════════════════════════════════════ -->
<!-- JAVASCRIPT                                                                -->
<!-- ════════════════════════════════════════════════════════════════════════ -->
<script>
// ── Tab switching ─────────────────────────────────────────────────────────────
function switchTab(tabId) {
  document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  const panel = document.getElementById('tab-' + tabId);
  if (panel) panel.classList.add('active');
  const btn = document.querySelector('.tab-btn[data-tab="' + tabId + '"]');
  if (btn) btn.classList.add('active');
  // Render sparklines that may not have been visible on load
  renderSparklines();
  updateRowCount(tabId);
}

// ── Section toggle ───────────────────────────────────────────────────────────
function toggleSection(header) {
  const body = header.nextElementSibling;
  const icon = header.querySelector('.toggle-icon');
  const isOpen = header.dataset.open === 'true';
  if (isOpen) {
    body.classList.add('collapsed');
    icon.style.transform = 'rotate(-90deg)';
    header.dataset.open = 'false';
  } else {
    body.classList.remove('collapsed');
    icon.style.transform = '';
    header.dataset.open = 'true';
  }
}

// ── Table sort (per team-group; groupId = "{viewId}-{groupIndex}") ────────────
const sortStates = {};
function groupIdToViewId(groupId) {
  return groupId.substring(0, groupId.lastIndexOf('-'));
}
function sortTable(colIdx, type, groupId) {
  const state = sortStates[groupId] || { col: -1, dir: 1 };
  const dir = (state.col === colIdx) ? -state.dir : 1;
  sortStates[groupId] = { col: colIdx, dir: dir };

  const tbody = document.getElementById('emp-tbody-' + groupId);
  if (!tbody) return;
  const rows = Array.from(tbody.querySelectorAll('tr'));

  rows.sort((a, b) => {
    const attrMap = { 5:'col6',6:'col7',7:'col8',8:'col9',9:'col10',10:'col11',11:'col12',13:'col14' };
    const getVal = (row, idx) => {
      if (attrMap[idx]) return row.dataset[attrMap[idx]] || '';
      return row.cells[idx] ? row.cells[idx].innerText.trim() : '';
    };
    let va = getVal(a, colIdx);
    let vb = getVal(b, colIdx);
    if (type === 'num') {
      va = parseFloat(va) || 0;
      vb = parseFloat(vb) || 0;
      return (va - vb) * dir;
    }
    return va.localeCompare(vb) * dir;
  });

  rows.forEach(r => tbody.appendChild(r));
  updateRowCount(groupIdToViewId(groupId));
}

// ── Table filter (per-tab, across all division team-groups) ───────────────────
function applyFilters(viewId) {
  const g = id => document.getElementById(id + '-' + viewId);
  const div  = g('f-division') ? g('f-division').value.toLowerCase()  : '';
  const lead = g('f-lead')     ? g('f-lead').value.toLowerCase()      : '';
  const flag = g('f-flag')     ? g('f-flag').value.toLowerCase()      : '';
  const type = g('f-emptype')  ? g('f-emptype').value                 : '';
  const q    = g('f-search')   ? g('f-search').value.toLowerCase()    : '';

  const groups = document.querySelectorAll('.team-group[data-view="' + viewId + '"]');
  groups.forEach(group => {
    const tbody = group.querySelector('tbody');
    if (!tbody) return;
    let anyVisible = false;
    Array.from(tbody.querySelectorAll('tr')).forEach(row => {
      const rDiv    = (row.dataset.division || '').toLowerCase();
      const rLead   = (row.dataset.lead     || '').toLowerCase();
      const rFlag   = (row.dataset.flag     || '').toLowerCase();
      const rPt     = row.dataset.pt      === 'PT';
      const rCorp   = row.dataset.corp    === 'Corp';
      const rPartial= row.dataset.partial === 'Partial';
      const rName   = (row.dataset.name   || '').toLowerCase();

      let show = true;
      if (div  && rDiv  !== div)  show = false;
      if (lead && rLead !== lead) show = false;
      if (flag && rFlag !== flag) show = false;
      if (type === 'PT'      && !rPt)     show = false;
      if (type === 'FT'      && (rPt || rCorp)) show = false;
      if (type === 'Corp'    && !rCorp)   show = false;
      if (type === 'Partial' && !rPartial) show = false;
      if (q    && !rName.includes(q))    show = false;

      row.style.display = show ? '' : 'none';
      if (show) anyVisible = true;
    });
    group.style.display = anyVisible ? '' : 'none';
  });

  updateRowCount(viewId);
}

function resetFilters(viewId) {
  ['f-division','f-lead','f-flag','f-emptype'].forEach(base => {
    const el = document.getElementById(base + '-' + viewId);
    if (el) el.value = '';
  });
  const s = document.getElementById('f-search-' + viewId);
  if (s) s.value = '';
  applyFilters(viewId);
}

function updateRowCount(viewId) {
  const countEl = document.getElementById('f-count-' + viewId);
  if (!countEl) return;
  const groups = document.querySelectorAll('.team-group[data-view="' + viewId + '"]');
  let total = 0, visible = 0;
  groups.forEach(group => {
    const rows = group.querySelectorAll('tbody tr');
    total += rows.length;
    visible += Array.from(rows).filter(r => r.style.display !== 'none').length;
  });
  countEl.textContent = `Showing ${visible} of ${total}`;
}

// ── SVG Sparklines ───────────────────────────────────────────────────────────
function renderSparklines() {
  document.querySelectorAll('svg.sparkline:not([data-rendered])').forEach(svg => {
    const raw  = svg.dataset.spark;
    const warn = parseFloat(svg.dataset.warn);
    const crit = parseFloat(svg.dataset.crit);
    if (!raw) return;

    let data;
    try { data = JSON.parse(raw); } catch(e) { return; }
    if (!data || !data.length) return;

    const W = parseInt(svg.getAttribute('width'))  || 120;
    const H = parseInt(svg.getAttribute('height')) || 36;
    const pad = { top: 3, bot: 3, left: 2, right: 2 };
    const iW = W - pad.left - pad.right;
    const iH = H - pad.top  - pad.bot;
    const n  = data.length;
    const barW = Math.max(2, Math.floor(iW / n) - 1);

    const warnY = pad.top + iH * (1 - warn);
    const critY = pad.top + iH * (1 - crit);

    svg.innerHTML = '';

    // Warn band
    const warnBand = document.createElementNS('http://www.w3.org/2000/svg','rect');
    warnBand.setAttribute('x', pad.left);
    warnBand.setAttribute('y', warnY);
    warnBand.setAttribute('width', iW);
    warnBand.setAttribute('height', critY - warnY);
    warnBand.setAttribute('fill', '#fef9c3');
    svg.appendChild(warnBand);

    // Crit band
    const critBand = document.createElementNS('http://www.w3.org/2000/svg','rect');
    critBand.setAttribute('x', pad.left);
    critBand.setAttribute('y', critY);
    critBand.setAttribute('width', iW);
    critBand.setAttribute('height', pad.top + iH - critY);
    critBand.setAttribute('fill', '#fee2e2');
    svg.appendChild(critBand);

    // Bars
    data.forEach((d, i) => {
      const x = pad.left + Math.round(i * (iW / n));
      const util = Math.min(1.5, Math.max(0, d.billable_util));
      const barH = Math.round(util * iH);
      const y = pad.top + iH - barH;

      const noData = d.net_available <= 0;
      const color = noData ? '#d1d5db'
        : (util < crit ? '#ef4444'
          : (util < warn ? '#f59e0b' : '#22c55e'));

      const rect = document.createElementNS('http://www.w3.org/2000/svg','rect');
      rect.setAttribute('x', x);
      rect.setAttribute('y', y);
      rect.setAttribute('width', barW);
      rect.setAttribute('height', barH || 1);
      rect.setAttribute('fill', color);
      rect.setAttribute('rx', '1');

      const title = document.createElementNS('http://www.w3.org/2000/svg','title');
      title.textContent = `${d.period_label}: ${(util*100).toFixed(1)}%`;
      rect.appendChild(title);
      svg.appendChild(rect);
    });

    // Threshold lines
    const mkLine = (y, color) => {
      const line = document.createElementNS('http://www.w3.org/2000/svg','line');
      line.setAttribute('x1', pad.left); line.setAttribute('x2', W - pad.right);
      line.setAttribute('y1', y);        line.setAttribute('y2', y);
      line.setAttribute('stroke', color); line.setAttribute('stroke-width','0.8');
      line.setAttribute('stroke-dasharray','2,2');
      svg.appendChild(line);
    };
    mkLine(warnY, '#f59e0b');
    mkLine(critY, '#ef4444');

    svg.setAttribute('data-rendered', '1');
  });
}

// ── Init ─────────────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  renderSparklines();
  // Initialize row counts for all tabs
  document.querySelectorAll('.tab-panel').forEach(panel => {
    const viewId = panel.id.replace('tab-', '');
    updateRowCount(viewId);
  });
  // Close modal on Escape
  document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
});

// ── Employee detail modal ────────────────────────────────────────────────────
const BILL_WARN = {{ billable_warning_threshold }};
const BILL_CRIT = {{ billable_critical_threshold }};

function openEmployeeModal(rowEl) {
  const detail = rowEl.dataset.detail;
  if (!detail) return;

  let periods;
  try { periods = JSON.parse(detail); } catch(e) { return; }

  const person  = rowEl.dataset.name    || '';
  const div     = rowEl.dataset.division || '';
  const lead    = rowEl.dataset.lead    || '';
  const org     = rowEl.dataset.org     || '';
  const type    = rowEl.dataset.type    || '';
  const flag    = rowEl.dataset.flag    || 'OK';
  const isPT    = rowEl.dataset.pt      === 'PT';
  const isCorp  = rowEl.dataset.corp    === 'Corp';
  const isPartial = rowEl.dataset.partial === 'Partial';

  // Title
  document.getElementById('modal-emp-name').textContent = person;

  let metaParts = [];
  if (org)  metaParts.push(org);
  if (div)  metaParts.push('Division: ' + div);
  if (lead) metaParts.push('Lead: ' + lead);
  if (type) metaParts.push('Type: ' + type);
  let badges = '';
  if (isPT)      badges += ' <span class="badge badge-pt">PT</span>';
  if (isCorp)    badges += ' <span class="badge badge-corp">Corp Role</span>';
  if (isPartial) badges += ' <span class="badge badge-partial">Partial Period</span>';
  if (flag === 'Critical') badges += ' <span class="badge badge-critical">Critical</span>';
  else if (flag === 'Warning') badges += ' <span class="badge badge-warning">Warning</span>';
  else badges += ' <span class="badge badge-ok">OK</span>';

  document.getElementById('modal-emp-meta').innerHTML =
    metaParts.join('&nbsp;&middot;&nbsp;') + badges;

  document.getElementById('modal-body').innerHTML = buildDetailTable(periods);

  const modal = document.getElementById('emp-modal');
  modal.style.display = 'flex';
  document.body.style.overflow = 'hidden';
}

function closeModal() {
  document.getElementById('emp-modal').style.display = 'none';
  document.body.style.overflow = '';
}

function buildDetailTable(periods) {
  if (!periods || !periods.length) {
    return '<p style="color:#9ca3af;font-style:italic;">No period data available for this range.</p>';
  }

  // Compute totals
  let totals = {
    billable_hrs:0, nonbillable_hrs:0, ga_hrs:0, bp_hrs:0,
    ird_hrs:0, overhead_hrs:0, pto_hrs:0, holiday_hrs:0,
    lwop_hrs:0, other_hrs:0, time_off_hrs:0, net_available:0, effective_avail:0
  };
  let activePeriods = 0;
  let totalBillUtil = 0;

  periods.forEach(p => {
    Object.keys(totals).forEach(k => { totals[k] += (p[k] || 0); });
    if (p.net_available > 0) { activePeriods++; totalBillUtil += p.billable_util; }
  });

  const avgUtil = activePeriods > 0 ? (totalBillUtil / activePeriods) : 0;

  const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  const fmt = v => (v === 0 ? '&mdash;' : esc(v.toFixed(1)));
  const fmtPct = v => esc(v.toFixed(1)) + '%';

  let rows = '';
  periods.forEach(p => {
    const noData = p.net_available === 0;
    let rowClass = noData ? 'no-data'
      : (p.billable_util < BILL_CRIT * 100 ? 'crit-row'
        : (p.billable_util < BILL_WARN * 100 ? 'warn-row' : ''));

    rows += `<tr class="${rowClass}">
      <td>${esc(p.period_label)}</td>
      <td>${noData ? '&mdash;' : fmtPct(p.billable_util)}</td>
      <td>${noData ? '&mdash;' : fmtPct(p.direct_util)}</td>
      <td>${fmt(p.billable_hrs)}</td>
      <td>${fmt(p.nonbillable_hrs)}</td>
      <td>${fmt(p.ga_hrs)}</td>
      <td>${fmt(p.bp_hrs)}</td>
      <td>${fmt(p.ird_hrs)}</td>
      <td>${fmt(p.overhead_hrs)}</td>
      <td>${fmt(p.pto_hrs)}</td>
      <td>${fmt(p.holiday_hrs)}</td>
      <td>${fmt(p.lwop_hrs)}</td>
      <td>${fmt(p.other_hrs)}</td>
      <td>${fmt(p.time_off_hrs)}</td>
      <td>${fmt(p.net_available)}</td>
      <td>${fmt(p.effective_avail)}</td>
    </tr>`;
  });

  const totalRow = `<tr>
    <td>Total / Avg</td>
    <td>${fmtPct(avgUtil)}</td>
    <td>&mdash;</td>
    <td>${fmt(totals.billable_hrs)}</td>
    <td>${fmt(totals.nonbillable_hrs)}</td>
    <td>${fmt(totals.ga_hrs)}</td>
    <td>${fmt(totals.bp_hrs)}</td>
    <td>${fmt(totals.ird_hrs)}</td>
    <td>${fmt(totals.overhead_hrs)}</td>
    <td>${fmt(totals.pto_hrs)}</td>
    <td>${fmt(totals.holiday_hrs)}</td>
    <td>${fmt(totals.lwop_hrs)}</td>
    <td>${fmt(totals.other_hrs)}</td>
    <td>${fmt(totals.time_off_hrs)}</td>
    <td>${fmt(totals.net_available)}</td>
    <td>${fmt(totals.effective_avail)}</td>
  </tr>`;

  return `<div style="overflow-x:auto;">
<table class="detail-table">
  <thead>
    <tr>
      <th>Period</th>
      <th>Bill. Util*</th><th>Direct Util*</th>
      <th>Billable</th><th>Non-Bill</th><th>G&amp;A</th><th>B&amp;P</th>
      <th>IR&amp;D</th><th>Overhead</th>
      <th>PTO</th><th>Holiday</th><th>LWOP</th><th>Other</th>
      <th>Time-Off Total</th><th>Sched. Hrs</th><th>Adj. Avail*</th>
    </tr>
  </thead>
  <tbody>${rows}</tbody>
  <tfoot>${totalRow}</tfoot>
</table>
</div>
<p class="modal-footnote">
  * Utilization = Billable &divide; Adj. Avail (Scheduled Hrs &minus; Time-Off).
  Rows with Sched.&nbsp;Hrs = 0 mean no timesheet data for that period.
  Hours column shows rounded values (totals may differ slightly from sum of individual periods).
</p>`;
}

// ── Settings panel ────────────────────────────────────────────────────────────
let _settingsLoaded = false;

function openSettings() {
  document.getElementById('settings-overlay').classList.add('open');
  if (!_settingsLoaded) loadSettings();
}

function closeSettings() {
  document.getElementById('settings-overlay').classList.remove('open');
}

async function loadSettings() {
  const statusEl = document.getElementById('s-status');
  statusEl.textContent = 'Loading…';
  try {
    const res = await fetch('/api/settings');
    const cfg = await res.json();

    document.getElementById('s-persist').value = cfg.persistence_threshold ?? 3;
    document.getElementById('s-bench').value   = Math.round((cfg.billable_utilization_benchmark ?? 0.75) * 100);
    document.getElementById('s-warn').value    = Math.round((cfg.billable_utilization_warning   ?? 0.65) * 100);
    document.getElementById('s-crit').value    = Math.round((cfg.billable_utilization_critical  ?? 0.50) * 100);

    // Build per-division rows
    const tbody = document.getElementById('div-tbody');
    tbody.innerHTML = '';
    const divisions = cfg.divisions && cfg.divisions.length ? cfg.divisions : ['MS1','MS2','MS3','IS1','BL1'];
    const overrides = cfg.division_thresholds || {};
    divisions.forEach(div => {
      const ov = overrides[div] || {};
      const bench = ov.billable_utilization_benchmark != null ? Math.round(ov.billable_utilization_benchmark * 100) : '';
      const warn  = ov.billable_utilization_warning   != null ? Math.round(ov.billable_utilization_warning   * 100) : '';
      const crit  = ov.billable_utilization_critical  != null ? Math.round(ov.billable_utilization_critical  * 100) : '';
      tbody.insertAdjacentHTML('beforeend', `
        <tr>
          <td class="div-name">${div}</td>
          <td><input type="number" class="settings-num" data-div="${div}" data-key="bench" min="0" max="100" step="1" value="${bench}" placeholder="—"></td>
          <td><input type="number" class="settings-num" data-div="${div}" data-key="warn"  min="0" max="100" step="1" value="${warn}"  placeholder="—"></td>
          <td><input type="number" class="settings-num" data-div="${div}" data-key="crit"  min="0" max="100" step="1" value="${crit}"  placeholder="—"></td>
        </tr>`);
    });

    const applyBtn = document.getElementById('s-apply-btn');
    applyBtn.textContent = cfg.can_rerun ? 'Save & Re-run' : 'Save (upload files to apply)';
    statusEl.textContent = cfg.can_rerun
      ? 'Ready — changes will trigger a full re-analysis.'
      : 'Settings saved to config. Upload files to apply.';
    _settingsLoaded = true;
  } catch(e) {
    statusEl.textContent = 'Could not load settings: ' + e.message;
  }
}

async function applySettings() {
  const statusEl   = document.getElementById('s-status');
  const applyBtn   = document.getElementById('s-apply-btn');
  const progWrap   = document.getElementById('s-progress-wrap');
  const progFill   = document.getElementById('s-progress-fill');

  // Build payload
  const payload = {
    persistence_threshold:          parseInt(document.getElementById('s-persist').value) || 3,
    billable_utilization_benchmark: parseInt(document.getElementById('s-bench').value) / 100,
    billable_utilization_warning:   parseInt(document.getElementById('s-warn').value)  / 100,
    billable_utilization_critical:  parseInt(document.getElementById('s-crit').value)  / 100,
    division_thresholds: {},
  };
  // Per-division inputs
  document.querySelectorAll('#div-tbody input[data-div]').forEach(inp => {
    const div = inp.dataset.div, key = inp.dataset.key;
    const val = inp.value.trim();
    if (val === '' || isNaN(parseInt(val))) return;
    if (!payload.division_thresholds[div]) payload.division_thresholds[div] = {};
    const cfgKey = key === 'bench' ? 'billable_utilization_benchmark'
                 : key === 'warn'  ? 'billable_utilization_warning'
                 :                   'billable_utilization_critical';
    payload.division_thresholds[div][cfgKey] = parseInt(val) / 100;
  });

  applyBtn.disabled = true;
  statusEl.textContent = 'Saving settings…';

  try {
    const res  = await fetch('/api/settings', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify(payload),
    });
    const data = await res.json();
    if (!data.ok) { statusEl.textContent = 'Error: ' + (data.error || 'unknown'); applyBtn.disabled = false; return; }

    if (!data.job_id) {
      statusEl.textContent = '✓ Settings saved. Upload files to see new flags.';
      applyBtn.disabled = false;
      return;
    }

    // Poll progress
    progWrap.style.display = 'block';
    statusEl.textContent = 'Re-running analysis…';
    const poll = setInterval(async () => {
      try {
        const sr = await fetch('/status/' + data.job_id);
        const s  = await sr.json();
        progFill.style.width = (s.progress || 0) + '%';
        statusEl.textContent = s.status_text || 'Running…';
        if (s.status === 'done') {
          clearInterval(poll);
          statusEl.textContent = '✓ Done — loading new dashboard…';
          window.top.location.href = '/latest';
        } else if (s.status === 'error') {
          clearInterval(poll);
          statusEl.textContent = '✗ Error: ' + s.error;
          applyBtn.disabled = false;
        }
      } catch(e) { /* keep polling */ }
    }, 800);
  } catch(e) {
    statusEl.textContent = 'Request failed: ' + e.message;
    applyBtn.disabled = false;
  }
}

// ── Hide all-zero optional columns in flag detail tables ─────────────────────
// Only hides columns marked data-opt (PTO, Holiday, LWOP, Other, B&P%, G&A%,
// IR&D%, Overhead%). Core columns (Bill. Util, Bill. Hrs, Sched. Hrs, etc.)
// are always kept even when all-zero, since they explain WHY the flag fired.
(function () {
  function isZero(text) {
    const n = parseFloat(text.trim().replace(/[%$,]/g, ''));
    return !isNaN(n) && n === 0;
  }
  document.querySelectorAll('.flag-table').forEach(tbl => {
    const headers = Array.from(tbl.querySelectorAll('thead th'));
    const bodyRows = Array.from(tbl.querySelectorAll('tbody tr'));
    headers.forEach((th, ci) => {
      if (!th.hasAttribute('data-opt')) return; // only hide optional columns
      const allZero = bodyRows.every(row => {
        const cell = row.cells[ci];
        return !cell || isZero(cell.textContent);
      });
      if (allZero) {
        th.style.display = 'none';
        bodyRows.forEach(row => { if (row.cells[ci]) row.cells[ci].style.display = 'none'; });
      }
    });
  });
})();
</script>
</body>
</html>
